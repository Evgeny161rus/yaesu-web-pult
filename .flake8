[flake8]
max-line-length = 127
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    *.egg-info

ignore =
    # W503: line break before binary operator (conflicts with black)
    W503,
    # W504: line break after binary operator (the codebase breaks after)
    W504,
    # E203: whitespace before ':' (conflicts with black)
    E203

per-file-ignores =
    __init__.py:F401
